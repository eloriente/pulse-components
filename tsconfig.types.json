{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.types.tsbuildinfo",
    "types": ["vite/client"],
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["src/mcp", "src/test-setup.ts", "src/**/*.stories.tsx", "src/**/*.test.tsx"]
}
