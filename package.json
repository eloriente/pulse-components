{
  "name": "@pulseui/react",
  "version": "1.0.2",
  "description": "PulseUI for React — an open-source React component library built with TypeScript and CSS Modules. Compatible with Tailwind CSS.",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "typescript",
    "css-modules",
    "tailwind"
  ],
  "license": "MIT",
  "author": "eloriente",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eloriente/pulseui-react.git"
  },
  "homepage": "https://github.com/eloriente/pulseui-react#readme",
  "bugs": {
    "url": "https://github.com/eloriente/pulseui-react/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": "./dist/tokens/index.css",
    "./styles": "./dist/style.css"
  },
  "bin": {
    "pulseui-react-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "prebuild": "npm run generate:mcp-data",
    "build": "vite build && npm run build:mcp",
    "build:mcp": "tsc -p tsconfig.mcp.json && chmod +x dist/mcp/server.js",
    "build:storybook": "storybook build",
    "generate:mcp-data": "tsx scripts/generate-mcp-data.ts",
    "check:mcp-data": "npm run generate:mcp-data && git diff --exit-code -- src/mcp/components-data.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:storybook": "vitest --project storybook",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "lucide-react": "^1.21.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.6",
    "ts-morph": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
